generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  passwordHash String?
  role        UserRole  @default(MANAGER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  clients     Client[]          @relation("ClientManager")
  createdClients Client[]       @relation("ClientCreator")
  activities  ClientActivity[]
  deals       ClientDeal[]
  documents   ClientDocument[]
  comments    ClientComment[]
  teamMessages TeamMessage[]
  createdTasks ClientTask[]     @relation("TaskCreator")
  assignedTasks ClientTask[]    @relation("TaskAssignee")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([role])
  @@index([isActive])
}

model TeamMessage {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Client {
  id             Int          @id @default(autoincrement())
  type           ClientType   @default(COMPANY)
  companyName    String?
  contactName    String?
  phone          String?
  secondaryPhone String?
  email          String?
  edrpou         String?
  city           String?
  address        String?
  website        String?
  status         ClientStatus @default(NEW)
  source         String?
  managerId      Int?
  manager        User?        @relation("ClientManager", fields: [managerId], references: [id], onDelete: SetNull)
  creatorId      Int?
  creator        User?        @relation("ClientCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorName    String?
  activities     ClientActivity[]
  deals          ClientDeal[]
  documents      ClientDocument[]
  comments       ClientComment[]
  tasks          ClientTask[]
  comment        String?      @db.Text
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([companyName])
  @@index([contactName])
  @@index([phone])
  @@index([email])
  @@index([edrpou])
  @@index([status])
  @@index([source])
  @@index([city])
  @@index([managerId])
  @@index([creatorId])
  @@index([createdAt])
  @@index([isArchived])
}

model ClientActivity {
  id         Int          @id @default(autoincrement())
  type       ActivityType @default(NOTE)
  content    String       @db.Text
  occurredAt DateTime     @default(now())
  clientId   Int
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([clientId, occurredAt])
  @@index([authorId])
  @@index([type])
}

model ClientDeal {
  id              Int       @id @default(autoincrement())
  title           String
  amount          Decimal   @default(0) @db.Decimal(14, 2)
  currency        String    @default("UAH") @db.VarChar(3)
  stage           DealStage @default(NEW)
  expectedCloseAt DateTime?
  description     String?   @db.Text
  clientId        Int
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId         Int?
  owner           User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, stage])
  @@index([ownerId])
  @@index([expectedCloseAt])
  @@index([stage])
}

model ClientDocument {
  id           Int              @id @default(autoincrement())
  title        String
  originalName String           @db.VarChar(255)
  storedName   String           @unique @db.VarChar(255)
  mimeType     String           @db.VarChar(150)
  size         Int
  category     DocumentCategory @default(OTHER)
  description  String?          @db.Text
  clientId     Int
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploaderId   Int?
  uploader     User?            @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderName String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId, createdAt])
  @@index([uploaderId])
  @@index([category])
}

model ClientComment {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([authorId])
}

model ClientTask {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  clientId     Int
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assigneeId   Int?
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeName String?
  creatorId    Int?
  creator      User?        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorName  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([clientId, status])
  @@index([assigneeId, status])
  @@index([creatorId])
  @@index([dueAt])
  @@index([priority])
}

enum ClientType {
  PERSON
  FOP
  COMPANY
}

enum ClientStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  WAITING
  INTERESTED
  NOT_INTERESTED
  CLIENT
  REJECTED
  ARCHIVED
}

enum UserRole {
  ADMIN
  MANAGER
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
  SYSTEM
}

enum DealStage {
  NEW
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum DocumentCategory {
  CONTRACT
  INVOICE
  ACT
  APPLICATION
  POWER_OF_ATTORNEY
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
